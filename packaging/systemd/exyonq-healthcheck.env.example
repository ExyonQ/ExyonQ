# ExyonQ healthcheck configuration.
# Copy this file to /etc/exyonq/healthcheck.env and edit it there.
#
# ExyonQ units to verify. The default is the packaged single-instance unit.
#EXYONQ_HEALTHCHECK_UNITS="exyonq.service"
#
# PHP-FPM is discovered from active units matching php*fpm* by default.
# Use an exact unit only when discovery is ambiguous; never hardcode a
# versioned unit such as php8.5.12-fpm. Set this to off to disable the check.
#EXYONQ_HEALTHCHECK_PHP_FPM_UNIT="php-fpm.service"
#EXYONQ_HEALTHCHECK_PHP_FPM_UNIT=off
#EXYONQ_HEALTHCHECK_PHP_FPM_PATTERN="php*fpm*"
#
# HTTP probes. Only 2xx is healthy; HTTPS verifies the certificate and
# redirects are not followed.
EXYONQ_HEALTHCHECK_URLS="http://127.0.0.1:8080/health"
#EXYONQ_HEALTHCHECK_TIMEOUT=5
#EXYONQ_HEALTHCHECK_STATUS_FILE=/var/lib/exyonq/status.txt
