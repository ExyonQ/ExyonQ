# Environment example for optional L2 Redis coordination (WC7D)
# Mount secret files; do not put secret bytes in the unit Environment=.

# Composition gate (explicit opt-in; not auto-wired by default)
# Environment=EXYONQ_L2_COORD_LAB=1

Environment=EXYONQ_NODE_ID=node-a
Environment=EXYONQ_L2_DEPLOYMENT_ID=prod-deploy
Environment=EXYONQ_L2_KNOWN_SITE_IDS=1
Environment=EXYONQ_REDIS_COORD_URL=redis://redis.internal:6379/
# EnvironmentFile=-/etc/exyonq/redis-coord.secrets.env
# EXYONQ_REDIS_COORD_PASSWORD=...

Environment=EXYONQ_L2_EVENT_HMAC_ACTIVE_KEY_ID=k1
Environment=EXYONQ_L2_EVENT_HMAC_ACTIVE_KEY_FILE=/run/secrets/exyonq_l2_hmac_active
# During rotation:
# Environment=EXYONQ_L2_EVENT_HMAC_PREVIOUS_KEY_ID=k0
# Environment=EXYONQ_L2_EVENT_HMAC_PREVIOUS_KEY_FILE=/run/secrets/exyonq_l2_hmac_previous
