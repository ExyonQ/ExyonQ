{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exyonq.local/schemas/release-manifest.schema.json",
  "title": "ExyonQ release-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "version",
    "git_tag",
    "git_commit",
    "created_at",
    "artifacts",
    "container_images"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "const": "ExyonQ" },
    "version": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^0\\.(1|2|3)([.-]|$)" }
    },
    "git_tag": { "type": "string", "pattern": "^v.+" },
    "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "created_at": { "type": "string", "minLength": 10 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "target", "arch", "os", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^artifacts/[^/]+$" },
          "target": { "type": "string" },
          "arch": { "type": "string" },
          "os": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "container_images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registry", "repository", "version_tag", "digest"],
        "properties": {
          "registry": { "type": "string" },
          "repository": { "type": "string" },
          "version_tag": { "type": "string", "not": { "const": "latest" } },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
