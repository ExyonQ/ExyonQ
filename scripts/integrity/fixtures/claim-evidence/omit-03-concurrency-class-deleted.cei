# OMIT-03 — regression fixture. The claim is about a rename/open race, the
# evidence is strong, but the field that selects the concurrency gate has been
# left out.
BEGIN_CLAIM_EVIDENCE_BLOCK
CLAIM_ID = OMIT-03
CLAIM = Config reload is safe against rename-then-open races
CLAIM_KIND = BEHAVIOR_PROOF
CLAIM_STATUS = VERIFIED
CLAIM_SCOPE = CRATE
CLAIM_PLATFORM = LINUX_AMD64
CLAIM_CLIENT = NOT_APPLICABLE
CLAIM_EXECUTION_CLASS = E2E
CLAIM_SOURCE_STATE = HEAD=0000dead0000beef STATE=CLEAN
SOURCE_BINDING = ILLUSTRATIVE
CLAIM_REQUIRED_EFFECT = POSITIVE_OBSERVATION every read observes one whole generation
EPISTEMIC_STATUS = PROVEN
CONTRACT_SOURCE = ARCHITECTURE_DOC
EVIDENCE = a barrier-synchronised reader and reloader on the amd64 evidence host
EVIDENCE_COMMAND = scripts/e2e/reload-race.sh --barrier --iterations 20000
EVIDENCE_SCOPE = CRATE
EVIDENCE_PLATFORM = LINUX_AMD64
EVIDENCE_CLIENT = NOT_APPLICABLE
EVIDENCE_EXECUTION_CLASS = E2E
EVIDENCE_SOURCE_STATE = HEAD=0000dead0000beef STATE=CLEAN
EVIDENCE_EXECUTION = EXECUTED
EVIDENCE_RESULT = PASS
EVIDENCE_ORACLE_ORIGIN = CONTRACT_DOC
EVIDENCE_INDEPENDENCE = INDEPENDENT
EVIDENCE_OBSERVED_EFFECT = POSITIVE_OBSERVATION every observed read carried one generation stamp
MIRRORED_IMPLEMENTATION_ORACLE = NO
SELF_CONFIRMING_TEST_LOOP_RISK = LOW
TARGET_CAUSAL_PATH = reader opens while the reloader renames the file
PATH_EXECUTED = YES
PATH_EXECUTION_EVIDENCE = INSTRUMENTATION harness counters record interleaved rename and open windows
CONCURRENCY_EVIDENCE_FORM = BARRIER_CONTROLLED_RACE
CLAIM_EVIDENCE_COMPATIBILITY = PASS
END_CLAIM_EVIDENCE_BLOCK
