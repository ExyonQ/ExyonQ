# CASE-06 — the implementation and the test enumerate the same hardcoded list,
# so both can be wrong in the same way.
# Owner spec case CASE-06: EXPECTED = SELF_CONFIRMING_RISK.
BEGIN_CLAIM_EVIDENCE_BLOCK
CLAIM_ID = CASE-06
CLAIM = Hop-by-hop headers are stripped before forwarding
CLAIM_KIND = BEHAVIOR_PROOF
CLAIM_STATUS = VERIFIED
CLAIM_SCOPE = MODULE
CLAIM_PLATFORM = DARWIN_ARM64
CLAIM_CLIENT = NOT_APPLICABLE
CLAIM_EXECUTION_CLASS = UNIT
CLAIM_SOURCE_STATE = HEAD=0000dead0000beef STATE=CLEAN
SOURCE_BINDING = ILLUSTRATIVE
CLAIM_REQUIRED_EFFECT = POSITIVE_OBSERVATION every header the RFC lists is removed
CLAIM_CONCURRENCY_CLASS = NONE
EPISTEMIC_STATUS = PROVEN
CONTRACT_SOURCE = IMPLEMENTATION
EVIDENCE = the test iterates the same header constant array the stripper iterates
EVIDENCE_COMMAND = cargo test -p exyonq-module-api hop_by_hop
EVIDENCE_SCOPE = MODULE
EVIDENCE_PLATFORM = DARWIN_ARM64
EVIDENCE_CLIENT = NOT_APPLICABLE
EVIDENCE_EXECUTION_CLASS = UNIT
EVIDENCE_SOURCE_STATE = HEAD=0000dead0000beef STATE=CLEAN
EVIDENCE_EXECUTION = EXECUTED
EVIDENCE_RESULT = PASS
EVIDENCE_ORACLE_ORIGIN = IMPLEMENTATION_DERIVED
EVIDENCE_INDEPENDENCE = IMPLEMENTATION_DERIVED
EVIDENCE_OBSERVED_EFFECT = POSITIVE_OBSERVATION the test assertions held
MIRRORED_IMPLEMENTATION_ORACLE = YES
SELF_CONFIRMING_TEST_LOOP_RISK = HIGH
TARGET_CAUSAL_PATH = NOT_APPLICABLE
PATH_EXECUTED = NOT_APPLICABLE
PATH_EXECUTION_EVIDENCE = NOT_APPLICABLE
CONCURRENCY_EVIDENCE_FORM = NONE
CLAIM_EVIDENCE_COMPATIBILITY = PASS
END_CLAIM_EVIDENCE_BLOCK
