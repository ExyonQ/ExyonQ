# --- Rust / Cargo ---
/target/
**/target/
/fuzz/target/
**/*.rs.bk
*.rlib
*.rmeta
.sccache/
rust-project.json
.cargo/config.toml.local

# --- Always exclude from this clean publication tree ---
# Ignore local/noncanonical docs content, but force-track canonical
# governance and security SoT subtrees (and historical release notes).
/docs/*
!/docs/security/
!/docs/security/**
!/docs/governance/
!/docs/governance/**
!/docs/releases/
!/docs/releases/**
# release.yml github-release body_path is docs/release/vX.Y.Z.md
!/docs/release/
!/docs/release/**
!/docs/compat/
!/docs/compat/**
!/docs/adr/
!/docs/adr/**
!/docs/architecture/
!/docs/architecture/**
!/docs/waf/
!/docs/waf/**
!/docs/control-api/
!/docs/control-api/**
# Competitive scoreboard (canonical JSON + generated HTML) — tracked SoT.
!/docs/benchmarks/
!/docs/benchmarks/README.md
!/docs/benchmarks/v044-p1-p14-competitive-dashboard.json
!/docs/benchmarks/v044-p1-p14-competitive-dashboard.html
# Ignore untracked benchmark dumps. Indexed files stay tracked.
# `/benchmarks/` as a directory ignore blocks un-ignore of harness sources
# (git cannot re-include a file under an excluded parent directory).
/benchmarks/*
!/benchmarks/scenarios/
/benchmarks/scenarios/*
!/benchmarks/scenarios/perf/
/benchmarks/scenarios/perf/*
!/benchmarks/scenarios/perf/adr_025_protector_loadgen.py
!/benchmarks/scenarios/perf/adr_025_protector_gates.py
!/benchmarks/scenarios/perf/adr_025_protector_consolidated.py
# ADR-025 Docker image source (must stay Git-bound; docker COPY ≠ git index).
!/benchmarks/docker/
/benchmarks/docker/*
!/benchmarks/docker/Dockerfile.exyonq
!/benchmarks/docker/Dockerfile.upstream
!/benchmarks/docker/docker-compose.bench.yml
!/benchmarks/docker/exyonq-entrypoint.sh
!/benchmarks/docker/exyonq-env.sh
!/benchmarks/scenarios/payloads/
/benchmarks/scenarios/payloads/*
!/benchmarks/scenarios/payloads/health.txt
!/benchmarks/scenarios/payloads/www/
/benchmarks/scenarios/payloads/www/*
!/benchmarks/scenarios/payloads/www/1k.bin
!/benchmarks/scenarios/payloads/www/64k.bin
!/benchmarks/scenarios/payloads/www/1m.bin
/results/
/raw/
/artifacts/
/tmp/
/.temp/
/.cache/
/graphify-out/
/dist/

*.log
*.env
*.env.*
*.pem
*.key
*.p12
*.pfx
*.bundle
*.tar
*.tar.gz
*.zip
*.zst
*.tgz
*.profraw
*.profdata
*.html
*.csv
*.kd25-sync-manifest
**/*.kd25-sync-manifest

# --- IDE / OS ---
.DS_Store
.idea/
.vscode/
!.vscode/settings.example.json
.cursor/
.cursor-local/
*.code-workspace

# --- Secrets / signing private material ---
cosign.key
release-private.key
**/id_rsa
**/id_ed25519
GPG_PRIVATE_KEY

# --- Exceptions: public examples only (private PEM never excepted) ---
!tests/**/*.html
!docs/benchmarks/v044-p1-p14-competitive-dashboard.html
!**/*.env.example
!packaging/**/*.env.example

# Static TLS private keys are forbidden (EXYONQ-SEC-PRIVATE-MATERIAL-ZERO).
# Use scripts/test-tls/generate-ephemeral-tls.sh at runtime.
**/tests/fixtures/tls/key.pem
**/tests/fixtures/tls/*.key
**/benchmarks/**/tls/key.pem
**/benchmarks/scenarios/fixtures/tls/key.pem
